# Laravel dashboard URL (Lerd site) and the token from the app's .env (WORKER_TOKEN)
DASHBOARD_URL=https://ifrs-painel.test
WORKER_TOKEN=
# mkcert root CA so requests trusts Lerd's HTTPS certificate
DASHBOARD_CA=

# Only for `python -m moodle_worker list` (local debugging)
MOODLE_URL=https://presencial.ifrs.edu.br
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Optional: path to the Claude Code CLI (auto-detected from PATH / Lerd shims)
CLAUDE_BIN=
